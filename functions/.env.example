# Functions runtime config. Copy to functions/.env (loaded by Firebase) and fill.
# Secrets for live payment gateways should use `firebase functions:secrets:set`.

# Which payment provider to use: manual | sslcommerz | bkash | stripe ...
PAYMENT_PROVIDER=manual

# Absolute base URL of the deployed site (used for payment return URLs).
SITE_URL=https://bitsflow.cc

# --- Example gateway secrets (uncomment when you wire one up) ---
# SSLCZ_STORE_ID=
# SSLCZ_STORE_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# STRIPE_SECRET_KEY=
