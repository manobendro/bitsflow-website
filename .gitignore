# build output
dist/
.output/

# dependencies
node_modules/
functions/node_modules/

# astro
.astro/

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# secrets / env
.env
.env.*
!.env.example
# Not a secret (just PUBLIC_USE_EMULATORS=true) and required: without it a fresh
# clone's `npm run dev` would talk to the PRODUCTION Firebase project.
!.env.development
functions/.env
functions/.env.*
!functions/.env.example
*-service-account*.json

# editor / os
.DS_Store
.vscode/*
!.vscode/extensions.json
Thumbs.db

# build output & test artifacts
# functions/lib is compiled from functions/src — built fresh by the firebase.json
# `predeploy` hook on every deploy, so it never goes stale in git.
functions/lib/
# Puppeteer screenshots — regenerated on every test run.
tests/shots/
