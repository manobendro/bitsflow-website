---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import T from '../../components/T.astro';
import { formatDate } from '../../lib/format';
import { ArrowLeft, ArrowRight, Clock, CalendarDays, Hexagon } from 'lucide-astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const BN_DIGITS = '০১২৩৪৫৬৭৮৯';
const toBnDigits = (n: number) =>
  String(n).replace(/\d/g, (d) => BN_DIGITS[Number(d)]);
const minutes = Math.max(
  1,
  Math.ceil((post.body ?? '').trim().split(/\s+/).filter(Boolean).length / 200)
);
const updated = post.data.updatedDate;

// Other posts to keep reading (newest first, excluding this one).
const more = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title={`${post.data.title} — Bitsflow Blog`} description={post.data.description}>
  <!-- Header -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-brand-50 to-paper"
    >
    </div>
    <div class="container-page pb-8 pt-8 sm:pb-10 sm:pt-12 lg:pt-16">
      <div class="mx-auto max-w-[40rem]">
        <a
          href="/blog"
          class="-ml-1 inline-flex min-h-9 items-center gap-1 rounded-md px-1 text-sm font-medium text-brand-700 hover:underline"
        >
          <ArrowLeft size={14} aria-hidden="true" /> <T en="All posts" bn="সব পোস্ট" />
        </a>
        {
          post.data.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {post.data.tags.map((t) => (
                <span class="chip bg-brand-50 text-brand-700">{t}</span>
              ))}
            </div>
          )
        }
        <h1
          class="mt-4 text-[2rem] font-extrabold leading-[1.12] tracking-tight text-ink sm:text-4xl lg:text-5xl lg:leading-[1.08]"
        >
          {post.data.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          {post.data.description}
        </p>

        <!-- Meta -->
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-black/5 pt-5 text-sm text-ink-soft">
          <span class="inline-flex items-center gap-2.5 font-medium text-ink">
            <span
              class="grid h-9 w-9 place-items-center rounded-md bg-brand-600 text-white"
              aria-hidden="true"
            >
              <Hexagon size={16} stroke-width={2.5} />
            </span>
            {post.data.author}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <CalendarDays size={15} aria-hidden="true" />
            <time datetime={post.data.pubDate.toISOString()}>
              <T en={formatDate(post.data.pubDate)} bn={formatDate(post.data.pubDate, 'bn')} />
            </time>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Clock size={15} aria-hidden="true" />
            <T en={`${minutes} min read`} bn={`${toBnDigits(minutes)} মিনিটে পড়া`} />
          </span>
          {
            updated && (
              <span>
                <T en="Updated" bn="আপডেট" />{' '}
                <time datetime={updated.toISOString()}>
                  <T en={formatDate(updated)} bn={formatDate(updated, 'bn')} />
                </time>
              </span>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    post.data.heroImage && (
      <div class="container-page">
        <div class="mx-auto max-w-4xl overflow-hidden rounded-xl border border-black/5 shadow-[var(--shadow-soft)]">
          <Image
            src={post.data.heroImage}
            alt=""
            class="aspect-[16/9] h-auto w-full object-cover"
            widths={[640, 960, 1400]}
            sizes="(min-width: 1024px) 56rem, 100vw"
            loading="eager"
          />
        </div>
      </div>
    )
  }

  <!-- Body: 40rem ≈ 65–70 characters for comfortable reading -->
  <article class="container-page pb-16 pt-6 sm:pb-20 sm:pt-8">
    <div
      class="prose prose-bitsflow mx-auto max-w-[40rem] prose-headings:font-extrabold prose-headings:tracking-tight prose-h2:mt-12 prose-h2:text-2xl prose-img:rounded-lg prose-li:my-1 sm:prose-lg"
    >
      <Content />
    </div>

    <!-- Next step CTA -->
    <aside
      class="mx-auto mt-14 max-w-[40rem] overflow-hidden rounded-xl bg-gradient-to-br from-brand-600 to-brand-800 p-6 text-white sm:p-8"
      aria-label="Try it yourself"
    >
      <h2 class="text-xl font-extrabold tracking-tight sm:text-2xl">
        <T en="Want to build this yourself?" bn="নিজে বানিয়ে দেখতে চাও?" />
      </h2>
      <p class="mt-2 max-w-lg text-[15px] leading-relaxed text-brand-100">
        <T
          en="Reserve a Bitsflow board from the first production run — no payment until we confirm your ship date."
          bn="প্রথম ব্যাচ থেকে একটা বিটসফ্লো বোর্ড রিজার্ভ করে রাখো — ডেলিভারির তারিখ কনফার্ম হওয়ার আগে কোনো টাকা লাগবে না।"
        />
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          href="/products/bitsflow-board"
          class="btn bg-white text-brand-700 hover:bg-brand-50"
        >
          <T en="Pre-book the board" bn="বোর্ডটা প্রি-বুক করো" />
          <ArrowRight size={16} aria-hidden="true" />
        </a>
        <a href="/blog" class="btn border border-white/40 text-white hover:bg-white/10">
          <T en="More tutorials" bn="আরও টিউটোরিয়াল" />
        </a>
      </div>
    </aside>
  </article>

  {
    more.length > 0 && (
      <section class="border-t border-black/5 bg-sand" aria-labelledby="more-title">
        <div class="container-page py-12 sm:py-16">
          <div class="mx-auto max-w-4xl">
            <h2 id="more-title" class="text-xl font-extrabold tracking-tight sm:text-2xl">
              <T en="Keep reading" bn="আরও পড়ো" />
            </h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 sm:gap-6">
              {more.map((p) => (
                <a href={`/blog/${p.id}/`} class="card-soft group flex flex-col p-5 sm:p-6">
                  <time
                    datetime={p.data.pubDate.toISOString()}
                    class="text-[13px] text-ink-soft"
                  >
                    <T en={formatDate(p.data.pubDate)} bn={formatDate(p.data.pubDate, 'bn')} />
                  </time>
                  <h3 class="mt-2 text-lg font-bold leading-snug text-ink transition-colors group-hover:text-brand-700">
                    {p.data.title}
                  </h3>
                  <p class="mt-2 flex-1 text-[15px] leading-relaxed text-ink-soft">
                    {p.data.description}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700">
                    <T en="Read post" bn="পড়ে ফেলো" />
                    <ArrowRight
                      size={15}
                      class="transition-transform group-hover:translate-x-0.5"
                      aria-hidden="true"
                    />
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
