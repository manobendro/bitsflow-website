---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Dashboard from '../../components/react/Dashboard.tsx';
import T from '../../components/T.astro';
---

<BaseLayout title="Dashboard — Bitsflow" description="Your Bitsflow orders and pre-books.">
  <section class="relative min-h-[60vh]">
    <!-- Soft band behind the greeting; cards sit on warm paper below it. -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-64 bg-gradient-to-b from-brand-50 to-paper"
      aria-hidden="true"
    >
    </div>
    <div class="container-page py-8 sm:py-12 lg:py-16">
      <Dashboard client:only="react">
        <!-- Shown until the island loads (client:only renders nothing on the server). -->
        <div slot="fallback" class="space-y-8" aria-busy="true">
          <p class="sr-only"><T en="Loading your dashboard…" bn="তোমার ড্যাশবোর্ড লোড হচ্ছে…" /></p>
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div class="space-y-2">
              <div class="skeleton h-9 w-52"></div>
              <div class="skeleton h-5 w-40"></div>
            </div>
            <div class="skeleton h-10 w-40"></div>
          </div>
          <div class="space-y-3">
            <div class="skeleton h-24 w-full"></div>
            <div class="skeleton h-24 w-full"></div>
          </div>
        </div>
      </Dashboard>
    </div>
  </section>
</BaseLayout>
