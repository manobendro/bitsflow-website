---
/**
 * Bangladesh flag as inline SVG — renders identically on every OS (the 🇧🇩
 * emoji falls back to "BD" text on Windows, which looks broken).
 * Flag spec: bottle-green field with an offset red disc.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className = '' } = Astro.props;
const w = size;
const h = Math.round(size * 0.6); // 5:3 ratio
---

<svg
  width={w}
  height={h}
  viewBox="0 0 50 30"
  role="img"
  aria-label="Bangladesh"
  class={`inline-block rounded-[2px] align-text-bottom ${className}`}
>
  <rect width="50" height="30" fill="#006a4e"></rect>
  <circle cx="22" cy="15" r="9" fill="#f42a41"></circle>
</svg>
