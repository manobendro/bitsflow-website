# Firebase Web SDK config (safe to expose to the browser; these are NOT secrets).
# Copy this file to ".env" and fill from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup
# In Astro, only variables prefixed with PUBLIC_ are available in client code.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# Keep this "false" in .env — it is the PRODUCTION value baked into `astro build`.
# Local development points at the emulators via `.env.development` (loaded only
# by `astro dev`), so you normally never flip this by hand.
PUBLIC_USE_EMULATORS=false
